# ─────────────────────────────────────────────────────────────
# EMOS Frontend — .gitignore  (React / Vite)
# ─────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Build Output ──────────────────────────────────────────────
dist/
dist-ssr/
build/
out/

# ── Vite Cache ────────────────────────────────────────────────
.vite/
vite.config.js.timestamp-*

# ── Environment & Secrets ─────────────────────────────────────
# NEVER commit secrets or API keys
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.staging
.env.production
.env.production.local

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Package Manager Locks (keep only one) ─────────────────────
# Uncomment whichever you do NOT use:
# yarn.lock
# pnpm-lock.yaml

# ── Testing ───────────────────────────────────────────────────
coverage/
.nyc_output/

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo

# ── IDEs & Editors ────────────────────────────────────────────
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains
.idea/
*.iml

# Vim / Neovim
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ── OS Files ──────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Storybook ─────────────────────────────────────────────────
storybook-static/

# ── Misc ──────────────────────────────────────────────────────
.cache/
tmp/
temp/
.tmp/
*.local
